#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (5, 5, 5)
                double3 target = (-3.978038431995401e-8, -3.978038254359717e-8, 7.956076863990802e-8)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./easyglider.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "vehicle"
    doc = "EasyGlider in FLU, metres and kilograms. /vehicle and /vehicle/body origins at the complete vehicle initial CoM. Body lumps base_link, IMU and four fixed neutral control surfaces; puller remains an independent rigid body. Body centerOfMass refers only to that lumped body and may differ from the complete vehicle CoM. Source inertias preserved, represented with diagonalInertia and principalAxes. Aerodynamic forces and surface actuation remain the responsibility of the external backend."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "vehicle" (
    apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    customData = {
        dictionary referenceModel = {
            string inertialSources = "Explicit links in attached vehicles.zip; external include models are unavailable."
            double3 initialTotalCoM = (0, 0, 0)
            double initialTotalMass = 1.49500014
            string surfaceTreatment = "Fixed geometry; source surface mass and inertia lumped into body at neutral configuration."
        }
    }
)
{
    bool physxArticulation:enabledSelfCollisions = 0
    token ui:displayName = "EasyGlider"
    float3 xformOp:rotateXYZ = (0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    def Xform "body" (
