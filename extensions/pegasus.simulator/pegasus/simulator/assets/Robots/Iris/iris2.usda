                        hidden = false
                    )
                    float inputs:metallic_texture_influence = 1 (
                        customData = {
                            float default = 1
                            dictionary range = {
                                float max = 1
                                float min = 0
                            }
                        }
                        displayGroup = "Reflectivity"
                        displayName = "Metallic Map Influence"
                        doc = "Blends between the constant value and the lookup of the metallic texture"
                        hidden = false
                    )
                    asset inputs:normalmap_texture = @http://omniverse-content-production.s3-us-west-2.amazonaws.com/Materials/Base/Textiles/Linen_Blue/Linen_Blue_N.png@ (
                        colorSpace = "raw"
                        customData = {
                            asset default = @http://omniverse-content-production.s3-us-west-2.amazonaws.com/Materials/Base/Textiles/Linen_Blue/Linen_Blue_N.png@
                        }
                        displayGroup = "Normal"
                        displayName = "Normal Map"
                        hidden = false
                    )
                    float inputs:opacity_constant = 1 (
                        customData = {
                            float default = 1
                            dictionary range = {
                                float max = 1
                                float min = 0
                            }
                        }
                        displayGroup = "Opacity"
                        displayName = "Opacity Amount"
