#!/bin/sh
#
# @name Pegasus Shuttle SITL
# @type Quadrotor Wide
#
# Geometry follows the Pegasus Shuttle USDA, converted from FLU to PX4 FRD.
# Motor outputs 1-4 correspond to Pegasus rotor_0 through rotor_3.
#

. ${R}etc/init.d/rc.mc_defaults

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# PX4 positions use forward, right and down axes. The rotors are 0.248 m
# from the body origin in X and Y; the common Z offset does not affect
# moments generated by vertical thrust.
param set-default CA_ROTOR0_PX 0.248
param set-default CA_ROTOR0_PY 0.248
param set-default CA_ROTOR0_KM 0.016
param set-default CA_ROTOR1_PX -0.248
param set-default CA_ROTOR1_PY -0.248
param set-default CA_ROTOR1_KM 0.016
param set-default CA_ROTOR2_PX 0.248
param set-default CA_ROTOR2_PY -0.248
param set-default CA_ROTOR2_KM -0.016
param set-default CA_ROTOR3_PX -0.248
param set-default CA_ROTOR3_PY 0.248
param set-default CA_ROTOR3_KM -0.016

# PX4's normalized motor signal maps linearly to rotor speed in Pegasus;
# the resulting thrust is quadratic in signal. Invert that curve in PX4.
param set-default THR_MDL_FAC 1.0

# Hover thrust in PX4's normalized (thrust-linear) units: weight / maximum thrust.
# Mass 3.50 kg (USD body 3.4357 kg + 4 rotors x 0.0161 kg) -> 34.34 N; maximum thrust
# 4 x 1.709716e-5 x 1400^2 = 134.04 N (vehicle_physics.SHUTTLE_PHYSICS) -> 0.256.
param set-default MPC_THR_HOVER 0.256

# Rate-loop gains. PX4's defaults suit a small quad (Iris: max pitch torque 2 x 7.07 N x 0.13 m
# on Iyy 0.029 kg m^2, ~63 rad/s^2 per unit normalized torque). The Shuttle has 2 x 33.5 N x
# 0.248 m on Iyy 0.0217 kg m^2 (~765 rad/s^2, 12x) and ~2x the yaw authority, so the default
# gains are divided by those ratios (defaults: P 0.15, I 0.2, D 0.003; yaw P 0.2, I 0.1).
param set-default MC_ROLLRATE_P 0.0125
param set-default MC_ROLLRATE_I 0.017
param set-default MC_ROLLRATE_D 0.00025
param set-default MC_PITCHRATE_P 0.0125
param set-default MC_PITCHRATE_I 0.017
param set-default MC_PITCHRATE_D 0.00025
param set-default MC_YAWRATE_P 0.1
param set-default MC_YAWRATE_I 0.05

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
